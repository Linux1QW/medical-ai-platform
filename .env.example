# ============================================================
# 医学问诊评估平台 v1.2 - Docker Compose 环境变量模板
# ============================================================
# 复制为 .env 后按需填写
# 注意: docker-compose.yml 中 x-backend-environment anchor 引用的变量在此定义
# ============================================================

# ── 运行环境 ──────────────────────────────────────────────
# development | staging | production
ENVIRONMENT=development

# ── MySQL 数据库 ──────────────────────────────────────────
MYSQL_USER=medical_app
MYSQL_PASSWORD=your-secure-mysql-password-here
MYSQL_DATABASE=medical_ai

# ── MySQL 迁移用户（DDL 权限）────────────────────────────
MYSQL_MIGRATION_USER=medical_migrate
MYSQL_MIGRATION_PASSWORD=your-migrate-password-here
# MIGRATION_OPERATOR_ID=

# ── JWT 安全 ─────────────────────────────────────────────
# 生产环境务必更换为随机字符串 (openssl rand -hex 32)
SECRET_KEY=change-this-to-a-secure-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_TOKEN_BLACKLIST_ENABLED=true
JWT_BLACKLIST_FAIL_CLOSED=false

# ── 阿里云百炼平台 Qwen API（必填）──────────────────────
DASHSCOPE_API_KEY=sk-your-dashscope-api-key-here
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# ── LangGraph 编排 ────────────────────────────────────────
LANGGRAPH_ENABLED=true
# LANGGRAPH_SHADOW_MODE=false

# ── Redis Checkpoint ─────────────────────────────────────
REDIS_CHECKPOINT_TTL=86400

# ── Function Call / Tool Use ─────────────────────────────
ENABLE_TOOL_USE=true
TOOL_USE_MODEL=qwen-max
# TOOL_USE_MAX_ROUNDS=4
# TOOL_USE_MAX_CALLS=8
# TOOL_USE_TIMEOUT_SECONDS=30

# ── RAG 检索 ─────────────────────────────────────────────
# ACTIVE_INDEX_VERSION=rag-v1

# ── 可观测性隐私策略 ─────────────────────────────────────
OBSERVABILITY_CAPTURE_CONTENT=false
# OBSERVABILITY_HMAC_KEY=  # staging/production 启用 Langfuse 时必填

# ── Langfuse 链路追踪（可选）─────────────────────────────
LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com

# ── 日志 ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── 端口映射 ─────────────────────────────────────────────
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-admin-password-here

# ── SSL（可选）────────────────────────────────────────────
SSL_ENABLED=false

# ── Coach 临床教练智能体（v1.2）──────────────────────────
# COACH_ENABLED=false  # staging/production 启用时需要
# COACH_HMAC_KEY=      # staging/production 启用 Coach 时必填（>= 32 字节）
# COACH_CONTEXT_TOKEN_LIMIT=16000
# COACH_OUTPUT_TOKEN_LIMIT=250
# COACH_HARD_TIMEOUT_SECONDS=8
# COACH_SSE_EVENT_TTL_SECONDS=3600

# ── Voice 语音问诊 LiveKit（v1.2）────────────────────────
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
