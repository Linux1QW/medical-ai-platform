# ============================================================
# 医学问诊评估平台 v1.1 — 根目录环境变量模板
# ============================================================
# 复制为 .env 后按需修改。
# 分组与 docker-compose.yml 的 x-backend-environment anchor 保持一致。
# ============================================================

# ── 运行环境 ──────────────────────────────────────────────
# development | staging | production（base compose 不硬编码，由 override 设置）
ENVIRONMENT=development

# ── MySQL 数据库 ──────────────────────────────────────────
MYSQL_HOST=mysql
MYSQL_PORT=3306
# 业务用户（仅 DML 权限，不得用于 DDL）
MYSQL_USER=medical_app
MYSQL_PASSWORD=
MYSQL_DATABASE=medical_ai

# ── MySQL 迁移用户（仅 DDL 权限，只注入 migrate 服务）─────
MYSQL_MIGRATION_USER=
MYSQL_MIGRATION_PASSWORD=
# 存量 backfill 时填写 active admin ID，正常部署留空
MIGRATION_OPERATOR_ID=

# ── MySQL 备份用户（只读，只供宿主备份脚本使用）──────────
MYSQL_BACKUP_USER=
MYSQL_BACKUP_PASSWORD=

# ── JWT 认证 ─────────────────────────────────────────────
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=60
# JWT 吊销 fail-closed（staging/production 必须 true）
JWT_BLACKLIST_FAIL_CLOSED=false

# ── Qwen LLM API ────────────────────────────────────────
DASHSCOPE_API_KEY=
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus

# ── LangGraph ────────────────────────────────────────────
LANGGRAPH_ENABLED=true
LANGGRAPH_SHADOW_MODE=false

# ── RAG ──────────────────────────────────────────────────
ACTIVE_INDEX_VERSION=rag-v1
RERANK_MODEL=gte-rerank

# ── Tool Use ─────────────────────────────────────────────
ENABLE_TOOL_USE=true
TOOL_USE_MODEL=qwen-max

# ── 可观测性 ─────────────────────────────────────────────
# /metrics 端点保护（production 必须通过 Docker secret 挂载，不放环境变量）
# METRICS_TOKEN=  # 仅 development/test 保留，staging/production 检测到拒绝启动
OBSERVABILITY_CAPTURE_CONTENT=false
OBSERVABILITY_HMAC_KEY=
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── 日志 ─────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Web 服务器 ────────────────────────────────────────────
# WEB_CONCURRENCY=2  # production 默认 2（2 CPU 不启动 4 个 worker）

# ── Redis 生产内存预算 ────────────────────────────────────
# REDIS_STATE_MAXMEMORY=512mb
# REDIS_STATE_MEMORY_LIMIT=768M
# REDIS_CACHE_MAXMEMORY=256mb
# REDIS_CACHE_MEMORY_LIMIT=384M

# ── Frontend ─────────────────────────────────────────────
FRONTEND_PORT=80
FRONTEND_SSL_PORT=443
SSL_ENABLED=false

# ── 监控（docker compose --profile monitoring）───────────
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# ── 容器镜像（staging/production）────────────────────────
# REPO=your-org/medical-ai-platform
# IMAGE_TAG=latest
