# ============================================================
# 医学问诊评估平台 — 环境变量配置模板
# 复制为 .env 后按需修改；所有项均有代码内默认值，未配置时取默认
# 分组与 backend/app/core/config.py 保持一致
# ============================================================

# ── 运行环境 ──────────────────────────────────────────────
# development | production（production 下 SECRET_KEY 必须显式配置）
ENVIRONMENT=development

# ── MySQL 数据库 ──────────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
# 建议使用仅授权业务库的专用账户（如 medical_app），避免使用 root
MYSQL_USER=medical_app
MYSQL_PASSWORD=your-mysql-password-here
MYSQL_DATABASE=medical_ai

# 连接池
# DB_POOL_SIZE=20
# DB_MAX_OVERFLOW=10
# DB_POOL_RECYCLE=3600
# DB_POOL_TIMEOUT=30

# ── JWT 认证 ─────────────────────────────────────────────
# 生产环境请使用足够长的随机字符串（如 openssl rand -hex 32）
SECRET_KEY=your-secret-key-change-in-production
# ALGORITHM=HS256
# ACCESS_TOKEN_EXPIRE_MINUTES=1440
# REFRESH_TOKEN_EXPIRE_DAYS=7
# JWT_TOKEN_BLACKLIST_ENABLED=true

# ── CORS（JSON 数组格式）────────────────────────────────
# CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# CORS_METHODS=["GET","POST","PUT","DELETE","OPTIONS"]
# CORS_HEADERS=["Content-Type","Authorization","X-Request-ID"]

# ── 阿里云百炼平台 Qwen API ──────────────────────────────
# API Key 优先从系统环境变量 DASHSCOPE_API_KEY 自动读取；如需覆盖取消注释：
# QWEN_API_KEY=your-qwen-api-key
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-max
# RERANK_MODEL=gte-rerank

# ── 通用 LLM 接入（Provider 无关，为空时回退 QWEN_*）────
# LLM_PROVIDER_TYPE=openai_compatible
# LLM_API_KEY=
# LLM_API_BASE_URL=
# LLM_MODEL=

# ── 模型路由（按任务重要度降级）──────────────────────────
# MODEL_CRITICAL=qwen-max
# MODEL_STANDARD=qwen-plus
# MODEL_LIGHTWEIGHT=qwen-turbo

# ── 跨 Provider Fallback ─────────────────────────────────
# JSON 数组，如 [{"name":"backup","type":"openai_compatible","api_key":"...","base_url":"...","model":"..."}]
# LLM_PROVIDERS=[]
# LLM_CIRCUIT_BREAKER_THRESHOLD=3

# ── LLM 并发控制 ─────────────────────────────────────────
# LLM_MAX_CONCURRENT=10
# LLM_SEMAPHORE_TIMEOUT=60

# ── LangGraph 编排 ───────────────────────────────────────
LANGGRAPH_ENABLED=true
# LANGGRAPH_SHADOW_MODE=false
# LANGGRAPH_GRAPH_VERSION=evaluation-graph-v1
# LANGGRAPH_CHECKPOINT_TTL_HOURS=24

# ── Redis Checkpoint ─────────────────────────────────────
REDIS_CHECKPOINT_URL=redis://localhost:6379/1
REDIS_CHECKPOINT_TTL=86400

# ── Celery 异步任务队列 ──────────────────────────────────
# CELERY_BROKER_URL=redis://localhost:6379/4
# CELERY_RESULT_BACKEND=redis://localhost:6379/5

# ── Function Call / Tool Use ─────────────────────────────
ENABLE_TOOL_USE=true
TOOL_USE_MODEL=qwen-max
TOOL_USE_MAX_ROUNDS=4
TOOL_USE_MAX_CALLS=8
TOOL_USE_TIMEOUT_SECONDS=30
TOOL_USE_MAX_RESULT_CHARS=6000
KNOWLEDGE_TOOL_MAX_RAG_CALLS=3
KNOWLEDGE_TOOL_MAX_MQE_CALLS=2
KNOWLEDGE_TOOL_MAX_HYDE_CALLS=1
TOOL_USE_FALLBACK_TO_LEGACY=true

# ── ReAct 模式 ───────────────────────────────────────────
ENABLE_REACT_KNOWLEDGE=true
ENABLE_REACT_REFLECTION=true
# REACT_MAX_STEPS=6
# REFLECTION_CONSISTENCY_THRESHOLD=0.3
# REFLECTION_EVIDENCE_MIN_SCORE=60.0

# ── LLM 建议生成 ─────────────────────────────────────────
ENABLE_LLM_SUGGESTION=true

# ── RAG 检索 ─────────────────────────────────────────────
# ACTIVE_INDEX_VERSION=rag-v1
# Metadata 预过滤
# ENABLE_METADATA_FILTER=false
# METADATA_FILTER_MIN_RESULTS=3
# 结果多样性重排
# ENABLE_DIVERSITY_RERANK=false
# MAX_CHUNKS_PER_SOURCE=2
# 三路 RRF 融合权重 [BM25, Dense, Sparse]
# RRF_WEIGHT_BM25=0.30
# RRF_WEIGHT_DENSE=0.45
# RRF_WEIGHT_SPARSE=0.25
# 两阶段重排打分权重
# RERANK_W_RELEVANCE=0.4
# RERANK_W_COMPLETENESS=0.3
# RERANK_W_AUTHORITY=0.2
# RERANK_W_FRESHNESS=0.1
# Small-to-Big 上下文扩展
# ENABLE_CONTEXT_EXPANSION=false
# CONTEXT_EXPANSION_WINDOW=1
# 抽取式上下文压缩
# ENABLE_CONTEXT_COMPRESSION=false
# COMPRESSION_MIN_CHARS=400
# COMPRESSION_TOP_SENTENCES=5
# COMPRESSION_MIN_SENT_SCORE=0.2

# ── OCR（扫描版 PDF 兜底，复用 Qwen-VL）──────────────────
# ENABLE_OCR=false
# OCR_MODEL=qwen-vl-ocr
# OCR_MIN_TEXT_THRESHOLD=50
# OCR_RENDER_DPI=200
# OCR_MAX_CONCURRENCY=4
# OCR_TIMEOUT_SECONDS=60

# ── BGE-M3 双表示（需本地模型，默认关闭）─────────────────
# BGE_M3_ENABLED=false
# BGE_M3_MODEL_PATH=BAAI/bge-m3
# BGE_M3_USE_FP16=false

# ── 缓存 ─────────────────────────────────────────────────
# LLM 响应缓存
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL=86400
LLM_CACHE_MAX_SIZE=10000
LLM_CACHE_SIMILARITY_THRESHOLD=0.95
# 检索结果缓存
# RETRIEVAL_CACHE_ENABLED=true
# RETRIEVAL_CACHE_TTL=86400
# RETRIEVAL_CACHE_MAX_SIZE=5000

# ── Prompt 版本管理 ──────────────────────────────────────
# JSON 映射覆盖 manifest.json 活跃版本，如 {"knowledge_check":"v2"}
# PROMPT_ACTIVE_VERSIONS={}

# ── 审计与数据留存 ───────────────────────────────────────
AUDIT_LOG_ENABLED=true
# AUDIT_LOG_RETENTION_DAYS=90
# EVALUATION_RUN_RETENTION_DAYS=180

# ── Token 用量管控 ───────────────────────────────────────
# TOKEN_DAILY_LIMIT=1000000
# COST_PER_1K_TOKENS=0.02

# ── 告警（钉钉/企微 Webhook）─────────────────────────────
# ALERT_WEBHOOK_URL=
# ALERT_WEBHOOK_TYPE=dingtalk
# LLM_ERROR_RATE_THRESHOLD=0.1

# ── 可观测性 ─────────────────────────────────────────────
# /metrics 端点保护：非空时需携带 Authorization: Bearer <token>；
# 生产环境未配置时 /metrics 默认拒绝访问
# METRICS_TOKEN=your-metrics-token
# 日志
# LOG_LEVEL=INFO
# LOG_FORMAT=json

# ── 监控服务（docker compose --profile monitoring，仅 compose 使用）─
# PROMETHEUS_PORT=9090
# GRAFANA_PORT=3000
# GRAFANA_ADMIN_USER=admin
# 启用 monitoring profile 时必配：Grafana 管理员密码
# GRAFANA_ADMIN_PASSWORD=

# ── Langfuse 链路追踪（可选）─────────────────────────────
# LANGFUSE_ENABLED=false
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
